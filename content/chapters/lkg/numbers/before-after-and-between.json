      "en": "After: count one more.",
      "hi": "बाद में: एक आगे गिनो।"
    },
    {
      "en": "Before: count one back.",
      "hi": "पहले: एक पीछे गिनो।"
    },
    {
      "en": "Between: the number in the middle.",
      "hi": "बीच में: बीच वाली संख्या।"
    }
  ],
  "examples": [
    {
      "problem": {
        "en": "What comes before 20?",
        "hi": "20 से पहले क्या आता है?"
      },
      "steps": [
        {
          "en": "Count back one from 20.",
          "hi": "20 से एक पीछे गिनो।"
        }
      ],
      "answer": "19"
    },
    {
      "problem": {
        "en": "What is between 24 and 26?",
        "hi": "24 और 26 के बीच क्या है?"
      },
      "steps": [
        {
          "en": "24, __, 26 → count: 24, 25, 26.",
          "hi": "24, __, 26 → गिनो: 24, 25, 26।"
        }
      ],
      "answer": "25"
    }
  ],
