// VidyaPath data model.
//
// SQLite is used for local development. For production switch `provider`
// to "postgresql" and point DATABASE_URL at a Postgres database.
//
// SQLite has no native enums, so enum-like columns are Strings. Their allowed
// values are defined in src/lib/constants.ts and validated in application code.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String
  role      String   @default("STUDENT") // STUDENT | PARENT | TEACHER | ADMIN
  username  String?  @unique // kid login: username + PIN
  phone     String?  @unique
  email     String?  @unique
  pinHash   String? // 4-digit kid PIN (hashed)
  avatar    String   @default("lion")
  language  String   @default("en") // en | hi
  createdAt DateTime @default(now())

  studentProfile StudentProfile?
  children       StudentProfile[] @relation("ParentChildren")
  progress       Progress[]
  attempts       Attempt[]
  bookmarks      Bookmark[]
  badges         UserBadge[]
  batches        Batch[]
  assignments    Assignment[]
  memberships    BatchMember[]
}

model StudentProfile {
  id         String   @id @default(cuid())
  userId     String   @unique
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  classId    String
  class      Class    @relation(fields: [classId], references: [id])
  boardId    String
  board      Board    @relation(fields: [boardId], references: [id])
  dob        DateTime?
  parentId   String?
  parent     User?    @relation("ParentChildren", fields: [parentId], references: [id])
  schoolName String?
}

model Board {
  id       String           @id @default(cuid())
  code     String           @unique // CBSE
  name     String
  classes  Class[]
  students StudentProfile[]
}

model Class {
  id         String  @id @default(cuid())
  slug       String  @unique // nursery, lkg, ukg, class-1 ... class-10
  name       String
  nameHi     String
  order      Int
  stage      String // FOUNDATIONAL | PREPARATORY | MIDDLE | SECONDARY
  ageRange   String
  audioFirst Boolean @default(false) // Nursery–Class 2: every text gets a speaker button
  boardId    String
  board      Board   @relation(fields: [boardId], references: [id])

  subjects Subject[]
  students StudentProfile[]
  batches  Batch[]
}

model Subject {
  id     String  @id @default(cuid())
  slug   String
  classId String
  class  Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  name   String
  nameHi String
  icon   String
  color  String
  order  Int
  book   String? // reference NCERT book name(s), for alignment only

  chapters Chapter[]
  ebooks   EBook[]

  @@unique([classId, slug])
}

model Chapter {
  id               String  @id @default(cuid())
  slug             String
  subjectId        String
  subject          Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  title            String
  titleHi          String?
  order            Int
  learningOutcomes Json    @default("[]")

  topics  Topic[]
  ebooks  EBook[]
  quizzes Quiz[]

  @@unique([subjectId, slug])
}

model Topic {
  id        String   @id @default(cuid())
  slug      String
  chapterId String
  chapter   Chapter  @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  title     String
  titleHi   String?
  order     Int
  lessons   Lesson[]

  @@unique([chapterId, slug])
}

model Lesson {
  id            String   @id @default(cuid())
  topicId       String
  topic         Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)
  title         String
  titleHi       String?
  contentBlocks Json     @default("[]")
  audioUrl      String?
  audioUrlHi    String?
  videoUrl      String?
  durationMin   Int      @default(10)
  status        String   @default("DRAFT") // DRAFT | REVIEWED | PUBLISHED
  updatedAt     DateTime @updatedAt

  progress  Progress[]
  quizzes   Quiz[]
  bookmarks Bookmark[]
}

model EBook {
  id          String   @id @default(cuid())
  subjectId   String?
  subject     Subject? @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  chapterId   String?
  chapter     Chapter? @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  title       String
  language    String   @default("en")
  sourceType  String // GENERATED | EXTERNAL
  fileUrl     String?
  externalUrl String?
  pages       Int?

  bookmarks Bookmark[]
}

model Quiz {
  id           String     @id @default(cuid())
  chapterId    String?
  chapter      Chapter?   @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  lessonId     String?
  lesson       Lesson?    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  title        String
  type         String // PRACTICE | CHAPTER_TEST | SAMPLE_PAPER
  timeLimitSec Int?
  questions    Question[]
  attempts     Attempt[]
  assignments  Assignment[]
}

model Question {
  id          String  @id @default(cuid())
  quizId      String
  quiz        Quiz    @relation(fields: [quizId], references: [id], onDelete: Cascade)
  type        String // MCQ | TF | FILL | MATCH | PICTURE_MCQ | DRAG
  prompt      Json
  options     Json    @default("[]")
  answer      Json
  explanation String?
  audioUrl    String?
  difficulty  Int     @default(1)
  order       Int     @default(0)
}

model Attempt {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  quizId     String
  quiz       Quiz      @relation(fields: [quizId], references: [id], onDelete: Cascade)
  score      Int
  answers    Json
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
}

model Progress {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId     String
  lesson       Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  status       String   @default("NOT_STARTED") // NOT_STARTED | IN_PROGRESS | DONE
  stars        Int      @default(0)
  lastPosition Int      @default(0)
  updatedAt    DateTime @updatedAt

  @@unique([userId, lessonId])
}

model Bookmark {
  id       String  @id @default(cuid())
  userId   String
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  ebookId  String?
  ebook    EBook?  @relation(fields: [ebookId], references: [id], onDelete: Cascade)
  lessonId String?
  lesson   Lesson? @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  page     Int?
  note     String?
}

model Badge {
  id    String      @id @default(cuid())
  code  String      @unique
  name  String
  icon  String
  users UserBadge[]
}

model UserBadge {
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badgeId  String
  badge    Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  earnedAt DateTime @default(now())

  @@id([userId, badgeId])
}

model Batch {
  id          String        @id @default(cuid())
  teacherId   String
  teacher     User          @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  classId     String
  class       Class         @relation(fields: [classId], references: [id])
  name        String
  members     BatchMember[]
  assignments Assignment[]
}

model BatchMember {
  batchId   String
  batch     Batch  @relation(fields: [batchId], references: [id], onDelete: Cascade)
  studentId String
  student   User   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@id([batchId, studentId])
}

model Assignment {
  id        String   @id @default(cuid())
  teacherId String
  teacher   User     @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  batchId   String
  batch     Batch    @relation(fields: [batchId], references: [id], onDelete: Cascade)
  quizId    String?
  quiz      Quiz?    @relation(fields: [quizId], references: [id], onDelete: Cascade)
  lessonId  String?
  dueAt     DateTime
}
